{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Capability for the settings window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-vault-status",
    "allow-vault-wipe",
    "allow-llm-get-settings",
    "allow-llm-save-settings",
    "allow-llm-set-key",
    "allow-llm-clear-key",
    "allow-llm-test",
    "allow-llm-complete",
    "allow-llm-stream"
  ]
}
